{
  // insightflo.co 홈페이지 Worker. 정적 페이지는 dist/에서 바로 나가고, /api/consult와 /admin만 Worker가 처리합니다.
  // 설정 절차와 전환 순서: docs/planning/11-cloudflare-migration.md
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "insightflo-homepage",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // 코드가 남기는 오류 기록만 보관하고, 요청마다 자동으로 남는 기록(헤더, 접속 정보)은 끕니다.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  // 전환 전에는 workers.dev 주소로 미리 확인합니다. 전환 뒤에는 false로 바꿉니다.
  "workers_dev": true,
  // 버전별 미리보기 주소는 쓰지 않습니다(같은 사이트가 여러 주소로 열리지 않게).
  "preview_urls": false,
  // 전환 단계에서 주석을 풉니다. www는 Redirect Rule로 insightflo.co에 보냅니다.
  // "routes": [{ "pattern": "insightflo.co", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insightflo-inquiries",
      // wrangler d1 create insightflo-inquiries --location apac 결과로 바꿉니다.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // 같은 IP에서 1분에 5건까지만 받습니다. 봇 차단은 Turnstile이 먼저 합니다.
  "ratelimits": [
    { "name": "CONSULT_LIMITER", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } }
  ],

  // Cloudflare Email Service. 확인된 수신 주소(대표 메일)로만 보낼 수 있게 묶어 둡니다.
  // 발신 도메인 notify.insightflo.co를 Email Sending에 등록해야 보낼 수 있습니다(Workers Paid).
  // 루트 도메인에 Email Routing을 켜면 MX가 Cloudflare로 바뀌어 Daum 메일을 못 받으므로 켜지 않습니다.
  // 메일 알림을 쓰지 않으면 MAIL_FROM을 빈 값으로 둡니다(알림은 '보내지 않음'으로 기록).
  "send_email": [{ "name": "EMAIL", "destination_address": "teo@insightflo.co" }],

  // 매일 03:00(한국 시간) 보관 기간이 지난 문의를 지웁니다.
  "triggers": { "crons": ["0 18 * * *"] },

  "vars": {
    "MAIL_FROM": "consult@notify.insightflo.co",
    "MAIL_TO": "teo@insightflo.co",
    // Cloudflare Zero Trust > Access 애플리케이션을 만든 뒤 채웁니다. 비어 있으면 관리 화면이 닫혀 있습니다.
    // ACCESS_TEAM_DOMAIN 형식: https://<팀 이름>.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "teo@insightflo.co"
  }
  // 비밀 값은 wrangler secret put으로 넣습니다: TURNSTILE_SECRET_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
}
