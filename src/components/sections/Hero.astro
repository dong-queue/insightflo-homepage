---
// 히어로: 약속 한 줄 + 실행 영수증(시그니처, 실제 시험 실행 숫자)
import Icon from '../common/Icon.astro';
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = (Astro.currentLocale as Lang) ?? defaultLang;
const t = useTranslations(lang);
const r = t('hero.receipt');
const rows: { k: string; v: string; hold: boolean }[] = r.rows;
---

<section id="hero" class="pt-24 pb-16 lg:flex lg:min-h-[44rem] lg:items-center" aria-labelledby="hero-title">
  <div class="mx-auto grid w-full max-w-page items-center gap-16 px-6 sm:px-8 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <h1 id="hero-title" class="h-display text-4xl sm:text-5xl xl:text-6xl">
        {t('hero.lines').map((line: string) => <span class="block">{line}</span>)}
      </h1>
      <p class="t-lead mt-6 max-w-measure">{t('hero.sub')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary w-full sm:w-auto" href="#contact">
          <Icon name="mail" />
          {t('hero.ctaPrimary')}
        </a>
        <a class="btn btn-ghost w-full sm:w-auto" href="#paperwork">{t('hero.ctaSecondary')}</a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="receipt-wrap mx-auto w-full max-w-md" role="group" aria-labelledby="receipt-title">
        <div class="receipt">
          <div data-print style="--i:0">
            <p id="receipt-title" class="text-lg font-bold leading-7">{r.label}</p>
            <p class="text-sm text-ink-2">{r.title}</p>
            <p class="text-sm text-ink-2">{r.date}</p>
          </div>
          <hr class="receipt-rule mt-4" data-print style="--i:1" />
          <dl class="mt-2">
            {rows.map((row, i) => (
              <div class="receipt-row" data-hold={row.hold ? '' : undefined} data-print style={`--i:${i + 2}`}>
                <dt>{row.k}</dt>
                <dd>
                  {row.v}
                  {row.hold && (
                    <span class="stamp" aria-hidden="true">
                      {r.stamp.map((w: string) => <span class="block">{w}</span>)}
                    </span>
                  )}
                </dd>
              </div>
            ))}
            <div class="receipt-row receipt-total mt-2 pt-3 font-bold" data-print style={`--i:${rows.length + 2}`}>
              <dt>{r.total.k}</dt>
              <dd>{r.total.v}</dd>
            </div>
          </dl>
          <hr class="receipt-rule mt-3" data-print style={`--i:${rows.length + 3}`} />
          <p class="mt-4 text-sm leading-6 text-ink-2" data-print style={`--i:${rows.length + 4}`}>{r.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>
