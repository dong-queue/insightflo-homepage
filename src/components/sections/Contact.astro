---
// @TASK 다국어 Contact
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);

const email = "teo@insightflo.co";
---

<section id="contact" class="py-24 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <!-- Mail Icon -->
    <div class="inline-flex p-3 bg-blue-50 rounded-2xl mb-8">
      <span class="material-symbols-outlined text-deep-blue text-4xl">mail</span>
    </div>

    <!-- Title -->
    <h2 class="text-4xl md:text-5xl font-bold text-navy mb-6">{t('contact.heading')}</h2>

    <!-- Description -->
    <p class="text-xl text-slate-600 mb-12">
      {t('contact.lines')[0]}<br/>
      {t('contact.lines')[1]}
    </p>

    <!-- Email & CTA -->
    <div class="flex flex-col items-center gap-8">
      <a href={`mailto:${email}`} class="text-3xl md:text-4xl font-extrabold text-deep-blue hover:text-blue-600 transition-colors">
        {email}
      </a>
      <a href={`mailto:${email}`} class="inline-flex items-center gap-3 px-12 py-5 bg-deep-blue text-white rounded-xl font-bold text-lg hover:bg-navy transition-all shadow-xl shadow-blue-900/10">
        <span class="material-symbols-outlined">send</span>
        {t('contact.cta')}
      </a>
    </div>
  </div>
</section>

<style>
  .text-deep-blue { color: #1E3A5F; }
  .bg-deep-blue { background-color: #1E3A5F; }
  .text-navy { color: #0F172A; }
  .bg-navy { background-color: #0F172A; }
</style>
