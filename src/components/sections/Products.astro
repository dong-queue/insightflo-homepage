---
// Products - 자체 AI 제품 섹션 (플랫폼 중심, 다국어)
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);
---

<section id="products" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <h2 class="text-sm font-bold text-deep-blue uppercase tracking-widest mb-3">{t('products.eyebrow')}</h2>
      <h3 class="text-4xl font-bold text-navy">{t('products.heading')}</h3>
      <p class="text-slate-500 mt-4 max-w-2xl mx-auto">
        {t('products.sub')}
      </p>
    </div>

    <!-- 메인: 워크플로우 자동화 플랫폼 -->
    <div class="bg-gradient-to-br from-slate-50 to-blue-50/50 p-10 md:p-14 rounded-3xl border border-blue-100 shadow-sm mb-8">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center text-deep-blue shrink-0">
          <span class="material-symbols-outlined text-4xl">account_tree</span>
        </div>
        <div>
          <span class="px-3 py-1 bg-deep-blue text-white rounded-full text-xs font-bold">{t('products.main.badge')}</span>
          <span class="px-3 py-1 bg-green-50 text-green-600 rounded-full text-xs font-bold ml-2">{t('products.main.status')}</span>
        </div>
      </div>
      <h4 class="text-2xl md:text-3xl font-bold text-navy mb-4">{t('products.main.title')}</h4>
      <p class="text-slate-600 mb-8 leading-relaxed max-w-3xl">
        {t('products.main.desc')}
      </p>
      <ul class="grid sm:grid-cols-3 gap-4 mb-8">
        {t('products.main.features').map((feature: string) => (
          <li class="flex items-start gap-3 text-slate-700 bg-white/70 rounded-xl p-4">
            <span class="material-symbols-outlined text-blue-500 text-xl shrink-0">check_circle</span>
            <span class="font-medium text-sm">{feature}</span>
          </li>
        ))}
      </ul>
      <p class="text-xs text-slate-400 leading-relaxed">
        {t('products.main.note')}
      </p>
    </div>

    <!-- 서브 제품 2종 -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- 온보딩 (운영 중) -->
      <div class="bg-white p-10 md:p-14 rounded-3xl shadow-sm border border-slate-100 hover:shadow-xl transition-shadow">
        <div class="flex items-start justify-between mb-8">
          <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center text-deep-blue">
            <span class="material-symbols-outlined text-4xl">newspaper</span>
          </div>
          <span class="px-3 py-1 bg-green-50 text-green-600 rounded-full text-xs font-bold">{t('products.onboarding.badge')}</span>
        </div>
        <h4 class="text-2xl font-bold text-navy mb-4">{t('products.onboarding.title')} <span class="text-slate-400 text-lg font-medium">{t('products.onboarding.tagline')}</span></h4>
        <p class="text-slate-600 mb-10 leading-relaxed">
          {t('products.onboarding.desc')}
        </p>
        <ul class="space-y-4 mb-10">
          {t('products.onboarding.features').map((feature: string) => (
            <li class="flex items-center gap-3 text-slate-700">
              <span class="material-symbols-outlined text-blue-500 text-xl">check_circle</span>
              <span class="font-medium">{feature}</span>
            </li>
          ))}
        </ul>
        <a href="https://mock.co.kr" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-deep-blue font-bold hover:underline">
          {t('products.onboarding.link')}
          <span class="material-symbols-outlined text-xl">arrow_outward</span>
        </a>
      </div>

      <!-- GEO/SEO 진단 에이전트 (개발 중) -->
      <div class="bg-white p-10 md:p-14 rounded-3xl shadow-sm border border-slate-100 hover:shadow-xl transition-shadow">
        <div class="flex items-start justify-between mb-8">
          <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center text-deep-blue">
            <span class="material-symbols-outlined text-4xl">troubleshoot</span>
          </div>
          <span class="px-3 py-1 bg-amber-50 text-amber-600 rounded-full text-xs font-bold">{t('products.geo.badge')}</span>
        </div>
        <h4 class="text-2xl font-bold text-navy mb-4">{t('products.geo.title')}</h4>
        <p class="text-slate-600 mb-10 leading-relaxed">
          {t('products.geo.desc')}
        </p>
        <ul class="space-y-4">
          {t('products.geo.features').map((feature: string) => (
            <li class="flex items-center gap-3 text-slate-700">
              <span class="material-symbols-outlined text-blue-500 text-xl">check_circle</span>
              <span class="font-medium">{feature}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
