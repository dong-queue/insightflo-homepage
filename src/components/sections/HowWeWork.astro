---
// 일하는 방식 (FDE): 첫 질문 + 진단 → 배치 → 검증 운영 → 이관
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = (Astro.currentLocale as Lang) ?? defaultLang;
const t = useTranslations(lang);
const steps: { t: string; d: string }[] = t('how.steps');
---

<section id="how" class="py-16 lg:py-24" aria-labelledby="how-title">
  <div class="mx-auto grid max-w-page gap-12 px-6 sm:px-8 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5">
      <h2 id="how-title" class="h-section">{t('how.title')}</h2>
      <p class="t-lead mt-6">{t('how.lead')}</p>
      <figure class="mt-10">
        <figcaption class="text-sm font-medium text-ink-2">{t('how.askLabel')}</figcaption>
        <blockquote class="mt-3 text-2xl font-bold leading-9 tracking-tight">“{t('how.ask')}”</blockquote>
      </figure>
    </div>

    <ol class="divide-y divide-line border-y border-line lg:col-span-6 lg:col-start-7" aria-label={t('how.stepsLabel')}>
      {steps.map((s, i) => (
        <li class="grid grid-cols-[3rem_minmax(0,1fr)] gap-4 py-6">
          <span class="pt-1 text-sm font-medium tabular-nums text-ink-2">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-xl font-semibold leading-7">{s.t}</h3>
            <p class="mt-2 text-ink-2">{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
