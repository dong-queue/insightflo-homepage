---
// @TASK 다국어 TechStack - 모델 버전 표기 없음 (시의성 유지)
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);
---

<section id="tech-stack" class="py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold text-deep-blue uppercase tracking-widest mb-3">{t('tech.eyebrow')}</h2>
      <h3 class="text-4xl font-bold text-navy">{t('tech.heading')}</h3>
    </div>

    <!-- Tech Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {t('tech.categories').map((category: { name: string; items: string[] }) => (
        <div class="space-y-4">
          <h5 class="text-xs font-bold text-slate-400 uppercase tracking-wider">{category.name}</h5>
          <div class="flex flex-wrap gap-2">
            {category.items.map((item) => (
              <div class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm font-semibold text-slate-700">
                <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                {item}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .text-deep-blue { color: #1E3A5F; }
  .text-navy { color: #0F172A; }
</style>
