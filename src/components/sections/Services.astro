---
// @TASK 다국어 Services
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);
---

<section id="services" class="py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <h2 class="text-sm font-bold text-deep-blue uppercase tracking-widest mb-3">{t('services.eyebrow')}</h2>
      <h3 class="text-4xl font-bold text-navy">{t('services.heading')}</h3>
    </div>

    <!-- Service Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- AI Consulting -->
      <div class="bg-white p-10 md:p-14 rounded-3xl shadow-sm border border-slate-100 hover:shadow-xl transition-shadow">
        <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center text-deep-blue mb-8">
          <span class="material-symbols-outlined text-4xl">neurology</span>
        </div>
        <h4 class="text-2xl font-bold text-navy mb-4">{t('services.ai.title')}</h4>
        <p class="text-slate-600 mb-10 leading-relaxed">
          {t('services.ai.desc')}
        </p>
        <ul class="space-y-4">
          {t('services.ai.features').map((feature: string) => (
            <li class="flex items-center gap-3 text-slate-700">
              <span class="material-symbols-outlined text-blue-500 text-xl">check_circle</span>
              <span class="font-medium">{feature}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- System Development -->
      <div class="bg-white p-10 md:p-14 rounded-3xl shadow-sm border border-slate-100 hover:shadow-xl transition-shadow">
        <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center text-deep-blue mb-8">
          <span class="material-symbols-outlined text-4xl">terminal</span>
        </div>
        <h4 class="text-2xl font-bold text-navy mb-4">{t('services.sys.title')}</h4>
        <p class="text-slate-600 mb-10 leading-relaxed">
          {t('services.sys.desc')}
        </p>
        <ul class="space-y-4">
          {t('services.sys.features').map((feature: string) => (
            <li class="flex items-center gap-3 text-slate-700">
              <span class="material-symbols-outlined text-blue-500 text-xl">check_circle</span>
              <span class="font-medium">{feature}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .text-deep-blue { color: #1E3A5F; }
  .text-navy { color: #0F172A; }
</style>
