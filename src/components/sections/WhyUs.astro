---
// @TASK Why Us 섹션 - 다국어
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);
---

<section id="why-us" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold text-deep-blue uppercase tracking-widest mb-3">{t('whyus.eyebrow')}</h2>
      <h3 class="text-4xl font-bold text-navy mb-6">{t('whyus.heading')}</h3>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto">
        {t('whyus.sub')[0]}<br class="hidden md:block" />
        {t('whyus.sub')[1]}
      </p>
    </div>

    <!-- Highlights Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {t('whyus.items').map((item: { icon: string; number: string; title: string; description: string }) => (
        <div class="text-center p-8 rounded-2xl bg-slate-50 hover:bg-blue-50 transition-colors group">
          <div class="w-16 h-16 mx-auto bg-white rounded-2xl flex items-center justify-center text-deep-blue mb-6 shadow-sm group-hover:shadow-md transition-shadow">
            <span class="material-symbols-outlined text-3xl">{item.icon}</span>
          </div>
          <div class="text-4xl font-extrabold text-navy mb-2">{item.number}</div>
          <div class="text-lg font-bold text-slate-800 mb-3">{item.title}</div>
          <p class="text-sm text-slate-500 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .text-deep-blue { color: #1E3A5F; }
  .text-navy { color: #0F172A; }
</style>
