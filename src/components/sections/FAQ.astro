---
// 자주 묻는 질문 (다국어). 구조화 데이터는 pages/Home.astro에서 만듭니다.
import Icon from '../common/Icon.astro';
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = (Astro.currentLocale as Lang) ?? defaultLang;
const t = useTranslations(lang);
const items: { q: string; a: string }[] = t('faq.items');
---

<section id="faq" class="border-t border-line py-16 lg:py-24" aria-labelledby="faq-title">
  <div class="mx-auto grid max-w-page gap-12 px-6 sm:px-8 lg:grid-cols-12 lg:gap-8">
    <h2 id="faq-title" class="h-section lg:col-span-4">{t('faq.title')}</h2>
    <div class="divide-y divide-line border-y border-line lg:col-span-8">
      {items.map((item) => (
        <details class="faq-item">
          <summary class="flex items-start justify-between gap-6 py-6 text-lg font-semibold leading-7">
            <span>{item.q}</span>
            <Icon name="plus" size={20} class="faq-icon mt-1 shrink-0" />
          </summary>
          <p class="-mt-2 pb-6 pr-10 text-ink-2">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
