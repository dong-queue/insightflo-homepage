---
// FAQ - 자주 묻는 질문 (다국어)
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);
---

<section id="faq" class="py-24 bg-white">
  <div class="max-w-3xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold text-deep-blue uppercase tracking-widest mb-3">FAQ</h2>
      <h3 class="text-4xl font-bold text-navy">{t('faq.heading')}</h3>
    </div>

    <div class="space-y-4">
      {t('faq.items').map((item: { q: string; a?: string; aHtml?: string }) => (
        <details class="group bg-slate-50 rounded-2xl border border-slate-100 open:bg-white open:border-slate-200 open:shadow-md transition-all">
          <summary class="flex items-center justify-between cursor-pointer px-6 md:px-8 py-6 text-lg font-bold text-navy list-none">
            {item.q}
            <span class="material-symbols-outlined text-deep-blue group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <div class="px-6 md:px-8 pb-6 text-slate-600 leading-relaxed">
            {item.aHtml ? <Fragment set:html={item.aHtml} /> : item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
  .text-deep-blue { color: #1E3A5F; }
</style>
