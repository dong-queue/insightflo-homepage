---
// @TASK 다국어 About
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);
---

<section id="about" class="py-24 bg-navy text-white overflow-hidden relative">
  <div class="absolute inset-0 tech-pattern opacity-10"></div>

  <div class="max-w-5xl mx-auto px-6 relative z-10">
    <!-- Vision & Mission -->
    <div class="mb-16">
      <span class="text-blue-400 font-bold tracking-widest text-sm uppercase mb-4 block">{t('about.eyebrow')}</span>
      <h2 class="text-3xl md:text-5xl font-bold leading-tight mb-8">
        {t('about.heading')[0]}<br/>{t('about.heading')[1]}
      </h2>
      <p class="text-xl text-slate-300 leading-relaxed max-w-3xl mb-6">
        {t('about.p1').split('\n').map((line: string, i: number) => (<>{i > 0 && <br class="hidden md:block" />}{line}</>))}
      </p>
      <p class="text-slate-400 leading-relaxed max-w-3xl">
        {t('about.p2').split('\n').map((line: string, i: number) => (<>{i > 0 && <br class="hidden md:block" />}{line}</>))}
      </p>
    </div>

    <!-- Expertise -->
    <div class="grid md:grid-cols-3 gap-6 mb-16">
      {t('about.domains').map((domain: { icon: string; title: string; desc: string }) => (
        <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
          <span class="material-symbols-outlined text-3xl text-blue-400 mb-4 block">{domain.icon}</span>
          <h4 class="text-lg font-bold mb-2">{domain.title}</h4>
          <p class="text-slate-400 text-sm">{domain.desc}</p>
        </div>
      ))}
    </div>

    <!-- Approach -->
    <div class="grid md:grid-cols-3 gap-12 pt-12 border-t border-white/10">
      {t('about.approach').map((item: { icon: string; title: string; desc: string }) => (
        <div>
          <h4 class="text-xl font-bold mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-blue-400">{item.icon}</span>
            {item.title}
          </h4>
          <p class="text-slate-400 text-sm leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bg-navy { background-color: #0F172A; }
  .tech-pattern {
    background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);
    background-size: 32px 32px;
  }
</style>
