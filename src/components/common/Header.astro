---
// @TASK 다국어 Header - 내비 사전 + KO/EN 전환기
import { useTranslations, alternatePath, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);
const switchHref = alternatePath(Astro.url.pathname, lang === 'ko' ? 'en' : 'ko');
---

<header class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-slate-100">
  <nav class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="#hero" class="flex items-center gap-2">
      <div class="w-10 h-10 bg-deep-blue rounded-lg flex items-center justify-center text-white">
        <span class="material-symbols-outlined font-bold">hub</span>
      </div>
      <span class="text-xl font-bold tracking-tight text-navy uppercase">InsightFlo</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#products" class="text-sm font-semibold text-slate-600 hover:text-deep-blue transition-colors">{t('nav.products')}</a>
      <a href="#services" class="text-sm font-semibold text-slate-600 hover:text-deep-blue transition-colors">{t('nav.services')}</a>
      <a href="#about" class="text-sm font-semibold text-slate-600 hover:text-deep-blue transition-colors">{t('nav.about')}</a>
      <a href="#contact" class="px-5 py-2.5 bg-deep-blue text-white rounded-lg text-sm font-bold hover:bg-navy transition-colors">{t('nav.contact')}</a>
      <a
        href={switchHref}
        class="text-xs font-bold text-slate-500 border border-slate-200 rounded-full px-3 py-1.5 hover:border-deep-blue hover:text-deep-blue transition-colors"
        aria-label={lang === 'ko' ? 'Switch to English' : '한국어로 전환'}
      >{lang === 'ko' ? 'EN' : 'KO'}</a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-button" class="md:hidden p-2" aria-label={lang === 'ko' ? '메뉴' : 'Menu'}>
      <span class="material-symbols-outlined text-slate-600">menu</span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-white border-t border-slate-100 px-6 py-4 space-y-4">
    <a href="#products" class="block text-slate-600 font-semibold py-2" data-mobile-link>{t('nav.products')}</a>
    <a href="#services" class="block text-slate-600 font-semibold py-2" data-mobile-link>{t('nav.services')}</a>
    <a href="#about" class="block text-slate-600 font-semibold py-2" data-mobile-link>{t('nav.about')}</a>
    <a href="#contact" class="block bg-deep-blue text-white rounded-lg px-5 py-3 text-center font-bold" data-mobile-link>{t('nav.contact')}</a>
    <a href={switchHref} class="block text-center text-sm font-bold text-slate-500 border border-slate-200 rounded-lg px-5 py-3" data-mobile-link>{lang === 'ko' ? 'English' : '한국어'}</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('[data-mobile-link]');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>

<style>
  .bg-deep-blue { background-color: #1E3A5F; }
  .text-deep-blue { color: #1E3A5F; }
  .text-navy { color: #0F172A; }
  .bg-navy { background-color: #0F172A; }
</style>
