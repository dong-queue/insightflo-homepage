---
// 떠 있는 내비게이션 + 모바일 전체 높이 메뉴 (다국어), 테마 전환, 언어 전환
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { useTranslations, alternatePath, homePath, defaultLang, type Lang } from '../../i18n/ui';

const lang = (Astro.currentLocale as Lang) ?? defaultLang;
const t = useTranslations(lang);
const home = homePath(lang);
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const is404 = /^\/404(\.html)?\/?$/.test(Astro.url.pathname);
const switchHref = is404 ? homePath(other) : alternatePath(Astro.url.pathname, other);

const items = [
  { id: 'paperwork', label: t('nav.paperwork') },
  { id: 'proof', label: t('nav.proof') },
  { id: 'how', label: t('nav.how') },
  { id: 'faq', label: t('nav.faq') },
];
---

<header class="nav-shell">
  <nav class="nav-bar" aria-label={t('nav.label')}>
    <a href={home} class="rounded-lg py-1 pr-2" aria-label={t('nav.home')}>
      <Logo />
    </a>

    <ul class="hidden items-center gap-6 lg:flex" role="list">
      {items.map((it) => (
        <li>
          <a class="nav-link" href={`${home}#${it.id}`} data-spy={it.id}>{it.label}</a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <a
        href={switchHref}
        hreflang={other}
        lang={other}
        class="nav-link hidden px-3 sm:inline-block"
        aria-label={t('nav.switchLabel')}
        data-lang-switch
      >{t('nav.switchShort')}</a>
      <button
        type="button"
        class="theme-toggle hidden min-[360px]:grid"
        aria-label={t('nav.theme')}
        aria-pressed="false"
        data-theme-toggle
      >
        <Icon name="moon" class="theme-icon-moon" />
        <Icon name="sun" class="theme-icon-sun" />
      </button>
      <a href={`${home}#contact`} class="btn btn-primary btn-sm">{t('nav.cta')}</a>
      <button
        type="button"
        class="menu-toggle lg:hidden"
        aria-expanded="false"
        aria-controls="menu-panel"
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
      >
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="sr-only" data-toggle-label>{t('nav.menu')}</span>
      </button>
    </div>
  </nav>

  <div id="menu-panel" class="menu-panel lg:hidden" hidden>
    <ul role="list">
      {items.map((it, i) => (
        <li class="menu-item" style={`--i:${i}`}>
          <a class="menu-link" href={`${home}#${it.id}`} data-menu-link>{it.label}</a>
        </li>
      ))}
      <li class="menu-item" style={`--i:${items.length}`}>
        <a class="menu-link" href={`${home}#contact`} data-menu-link>{t('nav.cta')}</a>
      </li>
      <li class="menu-item mt-8 flex flex-wrap items-center gap-x-8 gap-y-4" style={`--i:${items.length + 1}`}>
        <a
          class="link text-base font-medium text-ink-2"
          href={switchHref}
          hreflang={other}
          lang={other}
          data-lang-switch
          data-menu-link
        >
          {t('nav.switchLong')}
        </a>
        <button type="button" class="theme-switch" aria-pressed="false" data-theme-toggle>
          <span>{t('nav.theme')}</span>
          <span class="theme-switch-track" aria-hidden="true"><span class="theme-switch-knob"></span></span>
        </button>
      </li>
    </ul>
  </div>
</header>

<script>
  import { THEME_KEY, THEME_COLOR, LANG_REVEAL_KEY, elementCenter, revealChange, type Theme } from '../../scripts/reveal';

  const root = document.documentElement;

  // 언어 전환: 누른 자리를 기억해 두면 새 페이지가 그 자리에서 원으로 퍼집니다(Layout의 pagereveal).
  // 메뉴가 닫히기 전에 위치를 읽어야 해서 메뉴 핸들러보다 먼저 등록합니다.
  function currentSectionId(): string | null {
    const line = window.innerHeight * 0.4;
    let current = '';
    for (const s of document.querySelectorAll<HTMLElement>('main section[id]')) {
      if (s.getBoundingClientRect().top <= line) current = s.id;
    }
    return current && current !== 'hero' ? current : null;
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const section = currentSectionId();
      if (section) {
        const url = new URL(link.href, location.href);
        url.hash = section;
        link.href = url.pathname + url.hash;
      }
      const origin = elementCenter(link) ?? { x: window.innerWidth - 48, y: 36 };
      try {
        sessionStorage.setItem(LANG_REVEAL_KEY, JSON.stringify({ ...origin, t: Date.now() }));
      } catch {
        // 저장할 수 없으면 연출 없이 이동합니다.
      }
    });
  });

  // 테마 전환
  const meta = document.querySelector('meta[name="theme-color"]');
  const themeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];
  const currentTheme = (): Theme => (root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

  function applyTheme(theme: Theme) {
    root.setAttribute('data-theme', theme);
    meta?.setAttribute('content', THEME_COLOR[theme]);
    themeButtons.forEach((b) => b.setAttribute('aria-pressed', String(theme === 'dark')));
  }
  function storedTheme(): Theme | null {
    try {
      const v = localStorage.getItem(THEME_KEY);
      return v === 'light' || v === 'dark' ? v : null;
    } catch {
      return null;
    }
  }

  applyTheme(currentTheme());
  themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const next: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
      revealChange(() => {
        applyTheme(next);
        try {
          localStorage.setItem(THEME_KEY, next);
        } catch {
          // 저장하지 못해도 이번 방문에는 적용됩니다.
        }
      }, elementCenter(button));
    });
  });
  // 직접 고르기 전까지는 시스템 설정을 따릅니다.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!storedTheme()) applyTheme(e.matches ? 'dark' : 'light');
  });

  // 도착할 때의 #섹션 이동은 바로, 이후의 앵커 이동은 부드럽게
  const markReady = () => requestAnimationFrame(() => root.setAttribute('data-ready', ''));
  if (document.readyState === 'complete') markReady();
  else window.addEventListener('load', markReady, { once: true });

  // 모바일 메뉴
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.getElementById('menu-panel');
  const label = toggle?.querySelector('[data-toggle-label]');

  function isOpen() {
    return toggle?.getAttribute('aria-expanded') === 'true';
  }

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
    panel.hidden = !open;
    panel.toggleAttribute('data-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) panel.querySelector<HTMLElement>('a')?.focus();
  }

  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  panel?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (!isOpen() || !toggle || !panel) return;
    if (e.key === 'Escape') {
      setOpen(false);
      toggle.focus();
      return;
    }
    if (e.key === 'Tab') {
      const focusables = [...panel.querySelectorAll<HTMLElement>('a, button')];
      const first = toggle;
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches && isOpen()) setOpen(false);
  });

  // 지금 읽는 섹션을 내비에 표시
  const spyLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  if (spyLinks.length && sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          spyLinks.forEach((a) => {
            if (a.dataset.spy === entry.target.id) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
