---
// 떠 있는 내비게이션 + 모바일 전체 높이 메뉴 (다국어)
import Logo from './Logo.astro';
import { useTranslations, alternatePath, homePath, defaultLang, type Lang } from '../../i18n/ui';

const lang = (Astro.currentLocale as Lang) ?? defaultLang;
const t = useTranslations(lang);
const home = homePath(lang);
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const is404 = /^\/404(\.html)?\/?$/.test(Astro.url.pathname);
const switchHref = is404 ? homePath(other) : alternatePath(Astro.url.pathname, other);

const items = [
  { id: 'paperwork', label: t('nav.paperwork') },
  { id: 'proof', label: t('nav.proof') },
  { id: 'how', label: t('nav.how') },
  { id: 'faq', label: t('nav.faq') },
];
---

<header class="nav-shell">
  <nav class="nav-bar" aria-label={t('nav.label')}>
    <a href={home} class="rounded-lg py-1 pr-2" aria-label={t('nav.home')}>
      <Logo />
    </a>

    <ul class="hidden items-center gap-6 lg:flex" role="list">
      {items.map((it) => (
        <li>
          <a class="nav-link" href={`${home}#${it.id}`} data-spy={it.id}>{it.label}</a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <a
        href={switchHref}
        hreflang={other}
        lang={other}
        class="nav-link hidden px-3 sm:inline-block"
        aria-label={t('nav.switchLabel')}
      >{t('nav.switchShort')}</a>
      <a href={`${home}#contact`} class="btn btn-primary btn-sm">{t('nav.cta')}</a>
      <button
        type="button"
        class="menu-toggle lg:hidden"
        aria-expanded="false"
        aria-controls="menu-panel"
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
      >
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="sr-only" data-toggle-label>{t('nav.menu')}</span>
      </button>
    </div>
  </nav>

  <div id="menu-panel" class="menu-panel lg:hidden" hidden>
    <ul role="list">
      {items.map((it, i) => (
        <li class="menu-item" style={`--i:${i}`}>
          <a class="menu-link" href={`${home}#${it.id}`} data-menu-link>{it.label}</a>
        </li>
      ))}
      <li class="menu-item" style={`--i:${items.length}`}>
        <a class="menu-link" href={`${home}#contact`} data-menu-link>{t('nav.cta')}</a>
      </li>
      <li class="menu-item mt-8" style={`--i:${items.length + 1}`}>
        <a class="link text-base font-medium text-ink-2" href={switchHref} hreflang={other} lang={other} data-menu-link>
          {t('nav.switchLong')}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.getElementById('menu-panel');
  const label = toggle?.querySelector('[data-toggle-label]');

  function isOpen() {
    return toggle?.getAttribute('aria-expanded') === 'true';
  }

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
    panel.hidden = !open;
    panel.toggleAttribute('data-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) panel.querySelector<HTMLElement>('a')?.focus();
  }

  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  panel?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (!isOpen() || !toggle || !panel) return;
    if (e.key === 'Escape') {
      setOpen(false);
      toggle.focus();
      return;
    }
    if (e.key === 'Tab') {
      const links = [...panel.querySelectorAll<HTMLElement>('a')];
      const first = toggle;
      const last = links[links.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches && isOpen()) setOpen(false);
  });

  // 지금 읽는 섹션을 내비에 표시
  const spyLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  if (spyLinks.length && sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          spyLinks.forEach((a) => {
            if (a.dataset.spy === entry.target.id) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
