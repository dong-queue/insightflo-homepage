---
// @TASK 다국어 Footer
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

const lang = ((Astro.currentLocale as Lang) ?? defaultLang);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const companyHref = lang === 'en' ? '/en/company/' : '/company/';
---

<footer class="py-16 bg-slate-50 border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Top Row -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-10">
      <!-- Logo -->
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-slate-300 rounded-lg flex items-center justify-center text-white">
          <span class="material-symbols-outlined text-sm">hub</span>
        </div>
        <span class="text-lg font-bold tracking-tight text-slate-500 uppercase">InsightFlo</span>
      </div>

      <!-- Social Links -->
      <div class="flex gap-8 text-sm text-slate-400 font-bold">
        <a href="https://www.linkedin.com/in/dongkyookwak" target="_blank" rel="noopener noreferrer" class="hover:text-deep-blue transition-colors">LinkedIn</a>
        <a href="https://github.com/insightflo" target="_blank" rel="noopener noreferrer" class="hover:text-deep-blue transition-colors">GitHub</a>
      </div>
    </div>

    <!-- Bottom Row -->
    <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-center md:text-left">
        <p class="text-xs text-slate-400 mb-2">{t('footer.biz')}</p>
        <p class="text-sm text-slate-400">© {currentYear} InsightFlo. {t('footer.rights')}</p>
      </div>
      <div class="flex gap-6 text-xs text-slate-400">
        <a href={companyHref} class="hover:underline">{t('footer.company')}</a>
        <a href="/privacy/" class="hover:underline">{t('footer.privacy')}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .text-deep-blue { color: #1E3A5F; }
</style>
