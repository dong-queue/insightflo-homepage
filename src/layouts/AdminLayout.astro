---
// 관리 화면 전용 레이아웃: 검색 제외, 마케팅 내비·푸터 없음, 테마는 사이트 설정을 따름
import '../styles/global.css';
import Logo from '../components/common/Logo.astro';

interface Props {
  title: string;
  email?: string;
}
const { title, email } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | InsightFlo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = null;
        try { theme = localStorage.getItem('insightflo:theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', theme);
      })();
    </script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-page flex-wrap items-center gap-4 px-6 py-4 sm:px-8">
        <a href="/" class="rounded-lg" aria-label="InsightFlo 홈"><Logo /></a>
        <span class="text-sm font-semibold text-ink-2">{title}</span>
        {email && <span class="ml-auto text-sm text-ink-2">{email}</span>}
      </div>
    </header>
    <main id="main" class="mx-auto max-w-page px-6 py-10 sm:px-8">
      <slot />
    </main>
  </body>
</html>
