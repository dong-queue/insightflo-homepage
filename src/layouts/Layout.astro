---
// 기본 레이아웃: 메타, 구조화 데이터, 서체, 건너뛰기 링크, 내비, 푸터 (ko/en, hreflang)
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { defaultLang, useTranslations, links, type Lang } from '../i18n/ui';
import { THEME_KEY, THEME_COLOR, LANG_REVEAL_KEY, REVEAL_MS, REVEAL_EASING } from '../scripts/reveal';

interface Props {
  title: string;
  description?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, schema = [], noindex = false } = Astro.props;
const lang = (Astro.currentLocale as Lang) ?? defaultLang;
const t = useTranslations(lang);
const desc: string = description ?? t('meta.homeDescription');

const site = Astro.site ?? new URL('https://insightflo.co');
const base = (Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/').replace(/\/?$/, '/');
const koHref = new URL(base, site).href;
const enHref = new URL('/en' + (base === '/' ? '/' : base), site).href;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(t('meta.ogImage'), site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'InsightFlo',
  alternateName: '인사이트플로',
  url: 'https://insightflo.co/',
  logo: new URL('/apple-touch-icon.png', site).href,
  email: links.email,
  foundingDate: '2025-06-16',
  address: { '@type': 'PostalAddress', addressLocality: 'Seoul', addressCountry: 'KR' },
  founder: {
    '@type': 'Person',
    name: '곽동규',
    alternateName: 'Dongkyoo Kwak',
    jobTitle: 'Forward Deployed Engineer',
    sameAs: [links.linkedin],
  },
  sameAs: [links.github, links.linkedinCompany, links.youtube, links.crunchbase],
};
const jsonLd = [organization, ...schema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link rel="alternate" hreflang="ko" href={koHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={koHref} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="InsightFlo" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.ogAlt')} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ko_KR'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f3f4f2" />
    <script define:vars={{ THEME_KEY, THEME_COLOR, LANG_REVEAL_KEY, REVEAL_MS, REVEAL_EASING }}>
      // 첫 화면을 그리기 전에 실행됩니다: 테마(깜빡임 없이), 언어 전환 원형 연출.
      var root = document.documentElement;
      root.classList.add('js');
      var theme = null;
      try { theme = localStorage.getItem(THEME_KEY); } catch (e) {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      root.setAttribute('data-theme', theme);
      var themeMeta = document.querySelector('meta[name="theme-color"]');
      if (themeMeta) themeMeta.setAttribute('content', THEME_COLOR[theme]);

      function skipReveal() {
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        return reduce || /SamsungBrowser\//i.test(navigator.userAgent);
      }
      function readReveal(consume) {
        var data = null;
        try {
          data = JSON.parse(sessionStorage.getItem(LANG_REVEAL_KEY) || 'null');
          if (consume) sessionStorage.removeItem(LANG_REVEAL_KEY);
        } catch (e) {}
        return data && Date.now() - data.t < 5000 ? data : null;
      }
      // 이전 페이지: 언어 전환으로 떠날 때만 전환을 남기고, 다른 이동은 평소처럼 바로 넘어갑니다.
      window.addEventListener('pageswap', function (event) {
        if (event.viewTransition && (!readReveal(false) || skipReveal())) event.viewTransition.skipTransition();
      });
      // 새 페이지: 누른 언어 버튼 자리에서 새 언어 화면이 원으로 퍼집니다.
      window.addEventListener('pagereveal', function (event) {
        var vt = event.viewTransition;
        if (!vt) return;
        var data = readReveal(true);
        if (!data || skipReveal()) { vt.skipTransition(); return; }
        vt.finished.then(null, function () {});
        vt.ready.then(function () {
          var w = window.innerWidth, h = window.innerHeight;
          var r = Math.hypot(Math.max(data.x, w - data.x), Math.max(data.y, h - data.y));
          var at = 'at ' + data.x + 'px ' + data.y + 'px';
          root.animate(
            { clipPath: ['circle(0px ' + at + ')', 'circle(' + r + 'px ' + at + ')'] },
            { duration: REVEAL_MS, easing: REVEAL_EASING, pseudoElement: '::view-transition-new(root)' }
          );
        }, function () {});
      });
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
